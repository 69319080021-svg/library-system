# ตัวอย่างค่าที่ต้องตั้งตอน deploy (ใส่ในหน้า Environment ของ Render ไม่ต้องสร้างไฟล์ .env)
# ตอนพัฒนาบนเครื่องไม่ต้องตั้งอะไร ระบบจะใช้ SQLite (library.db) เอง

# connection string จาก Neon (Dashboard > Connect)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ที่อยู่หน้าเว็บบน Vercel (ไม่มี / ท้าย) หลายที่คั่นด้วย ,
ALLOWED_ORIGINS=https://your-app.vercel.app
